# PostgreSQL (single source of truth — required for production catalog)
# Example: postgresql://user:pass@localhost:5432/bingin_diaries
DATABASE_URL=

# Admin authentication (required for /admin)

ADMIN_PASSWORD=change-me-to-a-strong-password

ADMIN_SECRET=change-me-to-a-long-random-secret-string



# Contact form — messages sent to this inbox (see server/email.mjs opsInbox)
EMAIL_OPS=info@bingindiaries.com

# Atlist store locator (optional — embed URL from atlist.com dashboard)
# VITE_ATLIST_EMBED_URL=
# VITE_ATLIST_MAP_URL=https://create.atlist.com/

# Instagram @bingindiaries — https://www.instagram.com/bingindiaries/

# Compte Business/Creator lié à une Page Facebook + app Meta

# Puis : npm run instagram:sync
# Automatisation hebdo : voir docs/instagram-automation.md (GitHub Actions)

INSTAGRAM_ACCESS_TOKEN=

INSTAGRAM_USER_ID=

# Option : URLs de posts séparées par des virgules (oEmbed)

# INSTAGRAM_POST_URLS=https://www.instagram.com/p/XXXX/,https://www.instagram.com/p/YYYY/



# Newsletter (server-only — never expose API keys in VITE_* vars)

# Provider: local | brevo | mailchimp | klaviyo

NEWSLETTER_PROVIDER=local



# Brevo (Sendinblue)

# BREVO_API_KEY=

# BREVO_LIST_ID=



# Mailchimp

# MAILCHIMP_API_KEY=

# MAILCHIMP_LIST_ID=

# MAILCHIMP_SERVER_PREFIX=us21



# Klaviyo

# KLAVIYO_API_KEY=

# KLAVIYO_LIST_ID=



# Stripe (server-only — never use VITE_* for secret keys)
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook: npm run stripe:webhook  (forwards to localhost:8080)
STRIPE_WEBHOOK_SECRET=
# Public site URL (success/cancel redirects)
SITE_URL=http://localhost:8080

# Transactional email — Resend (https://resend.com)
# Without RESEND_API_KEY, emails log to console in dev
RESEND_API_KEY=
EMAIL_FROM=Bingin Diaries <hello@bingindiaries.com>
EMAIL_OPS=hello@bingindiaries.com

# Analytics & marketing (client — only loaded after cookie consent)

# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# VITE_META_PIXEL_ID=


